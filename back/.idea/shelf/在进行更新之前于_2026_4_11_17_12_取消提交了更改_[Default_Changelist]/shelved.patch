-        }).then(() => {
-          const arr = Array.isArray(ids) ? ids : [ids];
-          const requests = arr.map(id => {
-            return deleteOrder({ id: id });
-          });
-          Promise.all(requests).then(responseArray => {
-            this.$message({
-              message: '删除成功！',
-              type: 'success',
-              duration: 1000
-            });
-            this.getList();
-          }).catch(err => {
-            this.$message({
-              message: '删除失败: ' + (err && err.message ? err.message : ''),
-              type: 'error',
-              duration: 2000
-            });
-          });
-        })
-      },
