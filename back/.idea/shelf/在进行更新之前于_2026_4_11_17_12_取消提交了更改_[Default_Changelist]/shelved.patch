-            type: 'warning',
-            duration: 2000
-          });
-          return false;
-        }
-        
-        if(!this.useOss){
-          //不使用oss不需要获取策略
-          return true;
-        }
-        
-        return new Promise((resolve, reject) => {
-          policy().then(response => {
