-          })
-        })
-      } else {
-        const payload = {
-          id: this.orderEditForm.id,
-          quantity: this.orderEditForm.quantity,
-          receiver: this.orderEditForm.receiver,
-          phone: this.orderEditForm.phone,
-          address: this.orderEditForm.address
